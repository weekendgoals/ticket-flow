{
  "manifest_version": 3,
  "name": "Flow Reporter",
  "version": "0.4.0",
  "description": "Files a Flow finding, a GitHub issue with screenshots, for the page you are looking at.",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage", "tabs", "unlimitedStorage"],
  "host_permissions": ["https://api.github.com/*"],
  "action": {
    "default_title": "Report a finding",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
